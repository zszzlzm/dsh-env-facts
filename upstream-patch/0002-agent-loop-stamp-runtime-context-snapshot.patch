+/** Insert the emission time after the snapshot header, leaving header and body untouched. */
+function stampSnapshot(snapshot: string): string {
+  if (!snapshot.startsWith(RUNTIME_CONTEXT_HEADER)) return snapshot
+  const stamped = `${RUNTIME_CONTEXT_HEADER}\nAs of ${new Date().toISOString()}`
+  return stamped + snapshot.slice(RUNTIME_CONTEXT_HEADER.length)
+}
+
+/** Remove the stamp again, so dedupe compares the snapshot body rather than its emission time. */
+function stripSnapshotStamp(snapshot: string | undefined): string | undefined {
+  if (snapshot === undefined) return undefined
+  const head = `${RUNTIME_CONTEXT_HEADER}\nAs of `
+  if (!snapshot.startsWith(head)) return snapshot
+  const lineEnd = snapshot.indexOf('\n', head.length)
+  return lineEnd < 0 ? snapshot : RUNTIME_CONTEXT_HEADER + snapshot.slice(lineEnd)
+}
 
